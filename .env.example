# ms-sensor-management - environment variables.
# Copy to .env and adjust the values. Never commit a .env with secrets.

# Server
SERVER_PORT=3004

# PostgreSQL (ADR-003)
POSTGRES_URL=jdbc:postgresql://localhost:5434/eduaircontrol_sensors
POSTGRES_USER=sensor_user
POSTGRES_PASSWORD=change-me

# Security (ADR-006/018): RS256 access tokens validated against the ms-security JWKS
JWKS_URI=http://localhost:8081/api/v1/auth/jwks
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ / sensor installation outbox (ADR-007)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
SENSOR_EVENTS_EXCHANGE=eduaircontrol.sensor
